# Dependencias y compilados
node_modules/
dist/
target/
src-tauri/target/
src-tauri/gen/schemas/

# Registros y temporales
*.log
*.tmp
.DS_Store
Thumbs.db

# Editores
.vscode/*
!.vscode/extensions.json
.idea/

# Claude Code: ajustes locales de esta máquina
.claude/settings.local.json
.claude/launch.json

# Imágenes de terceros para investigar: se guardan en local, nunca en Git
docs/investigacion/*/imagenes/
__pycache__/
datos/glosario/.cache/

# Salida de npm run validar:v2: se genera, no se guarda
datos/v2/validacion.txt

# Tu biblioteca de fórmulas copiada por migracion-v3/copiar-biblioteca.ts (plan v3, 7.4): no va a Git
migracion-v3/biblioteca/archivos/
# La tanda 10 lleva tus fórmulas enteras: fuera de Git, como la biblioteca (su informe sí entra)
migracion-v3/tandas/10-formulas/*
!migracion-v3/tandas/10-formulas/informe.md

# Lo que compara migracion-v3/subir-cuenta.ts: tus datos, no van a Git
migracion-v3/subir-cuenta/
