// Publishing the app (plan v3, step 9.2): Cloudflare serves the built PWA (dist/) as static files,
// nothing else; every address that is not a file opens the app (its routes live after «#»).
// Deploy: npm run build, then npx wrangler deploy (with your Cloudflare login).
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "perfumeria-v3",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
