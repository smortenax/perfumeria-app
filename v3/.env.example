# Cópialo como .env.local (que no va a Git) y pon los valores. Aquí solo van los nombres.
# En local, `npm run env:local` lo escribe solo.

# --- Supabase local (`npm run db:start`; `npx supabase status` da la URL y la clave publicable)
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=

# --- PowerSync local (paso 1.4). En desarrollo, por el propio sitio: Vite lo pasa al 8080
# (vite.config.ts). En la nube, la dirección de la instancia de PowerSync.
VITE_POWERSYNC_URL=/powersync
# La contraseña del rol de PowerSync en la base local: la eliges tú (`npm run db:powersync-password`)
POWERSYNC_DB_PASSWORD=

# --- Solo en local: la clave secreta del Supabase local y dos usuarios de prueba (npm run db:test-users)
SUPABASE_LOCAL_SECRET_KEY=
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=

# --- La nube (qizruaizjyvwbitpreoq), solo para `supabase db push`: la contraseña de la base de datos
SUPABASE_DB_PASSWORD=

# --- Opcional, solo en desarrollo: el botón «Entrar como tú, sin contraseña» de la pantalla de entrada
# (vite.config.ts). Solo tu correo: el servidor de desarrollo pide al Supabase local un acceso de un
# solo uso para él. La versión publicada (`npm run build`) no lo lleva.
DEV_LOGIN_EMAIL=
